#!/usr/bin/env python
"""
Create repeat library from dante_ltr output
require mmseqs2!
"""
import argparse
import os
import subprocess



def main():

    # get arguments
    parser = argparse.ArgumentParser(
            description=('Creation of repeat library from dante_ltr output. '
                         'Extract sequences based on gff3 inpute and reference fasta '
                         'file. Run mmseqs2 clustering to cluster similar sequences to '
                         'reduce library size. Exclude clusters which have conflicting '
                         'annotations and coverage below specified threshold.'),
            )
    parser.add_argument('-g', '--gff3', required=True, help='gff3 file')
    parser.add_argument('-s', '--reference_sequence', required=True, help='fasta file')
    parser.add_argument('-o', '--output_dir', required=True,
                        help='output directory')
    parser.add_argument('-m',
                        '--min_coverage', required=False, default=3, type=int,
                        help='Minimum coverage of cluster to be included in repeat '
                             'library (default: 3)')
    parser.add_argument('-c', '--cpu', required=False, default=1, type=int,
                        help='Number of cpus to use')
    parser.add_argument('-p', '--proportion_min', required=False, default=0.95,
                        help="Proportion of sequences in cluster that need to have "
                             "the same annotation to be included in repeat library "
                             "(default: 0.95)")

    parser.add_argument('-a', '--annotation_conflict', required=False,
                        default='strict', choices=['strict', 'nested'],
                        help="How to treat a cluster whose members carry different "
                             "classifications. 'strict' (default) reproduces the "
                             "historical behaviour. 'nested' keeps a cluster whose "
                             "labels form a single ancestor chain -- the normal "
                             "output of 'dante_ltr --mode core' -- and may promote "
                             "it to the deepest label the evidence supports. Note "
                             "that 'nested' can also REMOVE a cluster that 'strict' "
                             "keeps: a mix of two sibling lineages plus their "
                             "parent is not a chain.")
    parser.add_argument('--lineage_promotion_min_elements', required=False,
                        default=2, type=int,
                        help='With --annotation_conflict nested: minimum number of '
                             'distinct elements that must carry the deepest label '
                             'before a cluster is promoted to it (default: 2)')
    parser.add_argument('--lineage_promotion_min_share', required=False,
                        default=0.25, type=float,
                        help='With --annotation_conflict nested: minimum share of '
                             "the cluster's elements that must carry the deepest "
                             'label (default: 0.25)')

    args = parser.parse_args()

    script_dir = os.path.dirname(os.path.realpath(__file__))
    # create output directory if it does not exist
    if not os.path.exists(args.output_dir):
        os.makedirs(args.output_dir)

    # extract sequences based on gff3 file
    cmd = (F"{script_dir}/utils/extract_fasta.R -f {args.reference_sequence}"
           F" -g {args.gff3} -o {args.output_dir}")
    subprocess.check_call(cmd, shell=True)

    # run mmseqs2 clustering
    cmd = (F"{script_dir}/utils/mmseq_clustering.R -f {args.output_dir}/TE_all.fasta"
           F" -o {args.output_dir}/mmseqs2 -m {args.min_coverage}"
           F" -p {args.proportion_min} -t {args.cpu}"
           F" -a {args.annotation_conflict}"
           F" --lineage_promotion_min_elements {args.lineage_promotion_min_elements}"
           F" --lineage_promotion_min_share {args.lineage_promotion_min_share}")

    subprocess.check_call(cmd, shell=True)



if __name__ == "__main__":
    main()